@model Adventure
@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2>Adventure Düzenle</h2>
            <form method="post" action="/Adventure/Update">
                <input type="hidden" asp-for="AdventureId" />
                <div class="mb-3">
                    <label>İkon</label>
                    <input type="text" class="form-control" asp-for="Icon" placeholder="fa fa-trophy">
                </div>
                <div class="mb-3">
                    <label>Başlık</label>
                    <input type="text" class="form-control" asp-for="Title">
                </div>
                <div class="mb-3">
                    <label>Açıklama</label>
                    <textarea class="form-control" asp-for="Description" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Kaydet
                </button>
                <a href="/Adventure/Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Geri Dön
                </a>
            </form>
        </div>
    </div>
</div>



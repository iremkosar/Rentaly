@model List<Rentaly.EntityLayer.Entities.Location>

<section id="section-hero" aria-label="section" class="jarallax">
    <img src="~/rentaly/images/background/1.jpg" class="jarallax-img" alt="">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12 text-light">
                <div class="spacer-double"></div>
                <div class="spacer-double"></div>
                <h1 class="mb-2">Bir <span class="id-color">araç</span> mı arıyorsunuz? Doğru yerdesiniz.</h1>
                <div class="spacer-single"></div>
            </div>

            <div class="col-lg-12">
                <div class="spacer-single sm-hide"></div>
                <div class="p-4 rounded-3 shadow-soft" data-bgcolor="#ffffff">
                    <form name="contactForm" id='contact_form' method="get" action="/CarList/Index">
                        <div class="row">
                            <!-- Sol: Araç Tipi (sadece görsel) -->
                            <div class="col-lg-6 mb30">
                                <h5>Araç Tipi Seç</h5>
                                <div class="de_form de_radio row g-3">
                                    <div class="radio-img col-lg-3 col-sm-3 col-6">
                                        <input id="radio-1a" name="Car_Type" type="radio" value="Otomobil" checked="checked">
                                        <label for="radio-1a"><img src="@Url.Content("~/rentaly/images/select-form/car.png")" alt="">Otomobil</label>
                                    </div>
                                    <div class="radio-img col-lg-3 col-sm-3 col-6">
                                        <input id="radio-1b" name="Car_Type" type="radio" value="Minivan">
                                        <label for="radio-1b"><img src="@Url.Content("~/rentaly/images/select-form/van.png")" alt="">Minivan</label>
                                    </div>
                                    <div class="radio-img col-lg-3 col-sm-3 col-6">
                                        <input id="radio-1c" name="Car_Type" type="radio" value="Minibüs">
                                        <label for="radio-1c"><img src="@Url.Content("~/rentaly/images/select-form/minibus.png")" alt="">Minibüs</label>
                                    </div>
                                    <div class="radio-img col-lg-3 col-sm-3 col-6">
                                        <input id="radio-1d" name="Car_Type" type="radio" value="Lüks">
                                        <label for="radio-1d"><img src="@Url.Content("~/rentaly/images/select-form/sportscar.png")" alt="">Lüks</label>
                                    </div>
                                </div>
                            </div>

                        

                            <!-- Sağ: Lokasyon ve Tarih -->
                            <div class="col-lg-6">
                                <div class="row">
                                    <div class="col-lg-6 mb20">
                                        <h5>Alış Lokasyonu</h5>
                                        <select name="pickUpLocation" class="form-control">
                                            <option value="">Lokasyon Seçiniz...</option>
                                            @foreach (var location in Model)
                                            {
                                                <option value="@location.LocationName">@location.LocationName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-6 mb20">
                                        <h5>Teslim Lokasyonu</h5>
                                        <select name="dropOffLocation" class="form-control">
                                            <option value="">Lokasyon Seçiniz...</option>
                                            @foreach (var location in Model)
                                            {
                                                <option value="@location.LocationName">@location.LocationName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-6 mb20">
                                        <h5>Alış Tarihi</h5>
                                        <input type="datetime-local" name="pickUpDateTime" class="form-control">
                                    </div>
                                    <div class="col-lg-6 mb20">
                                        <h5>Teslim Tarihi</h5>
                                        <input type="datetime-local" name="returnDateTime" class="form-control">
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <input type="submit" value="Araç Bul" class="btn-main pull-right">
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="spacer-double"></div>

            @await Component.InvokeAsync("HowItWork")
        </div>
    </div>
</section>
@model List<Car>
<style>
    #items-carousel {
        position: relative;
        padding: 0 50px;
    }

        #items-carousel .owl-nav {
            position: absolute;
            top: 40%;
            width: 100%;
            left: 0;
            transform: translateY(-50%);
            display: flex;
            justify-content: space-between;
            pointer-events: none;
        }

            #items-carousel .owl-nav button {
                pointer-events: all;
                background: white !important;
                border-radius: 50% !important;
                width: 40px !important;
                height: 40px !important;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15) !important;
                font-size: 18px !important;
                color: #333 !important;
            }

                #items-carousel .owl-nav button:hover {
                    background: #f0f0f0 !important;
                }
</style>

<section id="section-cars">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 offset-lg-3 text-center">
                <h2>Araç Filomuz</h2>
                <p>Unutulmaz yolculuklar için çok yönlü araçlardan oluşan eşsiz filomuzla hayallerinizi gerçeğe dönüştürüyoruz.</p>
                <div class="spacer-20"></div>
            </div>
            <div id="items-carousel" class="owl-carousel wow fadeIn">
                @foreach (var item in Model)
                {
                    <div class="col-lg-12">
                        <div class="de-item mb30">
                            <div class="d-img" style="height: 220px; overflow: hidden;">
                                <img src="@item.ImageUrl" class="img-fluid" style="width:100%; height:100%; object-fit:cover;" alt="">
                            </div>
                            <div class="d-info">
                                <div class="d-text">
                                    <h4>@item.Brand.BrandName</h4>                                  
                                    <div class="d-atr-group" style="display:flex; flex-direction:row; gap:10px; align-items:center;">
                                        <span class="d-atr" style="display:flex; align-items:center; gap:4px;">
                                            <img src="~/Rentaly/images/icons/1-green.svg" width="16" height="16" alt="">@item.SeatCount
                                        </span>
                                        <span class="d-atr" style="display:flex; align-items:center; gap:4px;">
                                            <img src="~/Rentaly/images/icons/2-green.svg" width="16" height="16" alt="">@item.LuggageCount
                                        </span>
                                        <span class="d-atr" style="display:flex; align-items:center; gap:4px;">
                                            <img src="~/Rentaly/images/icons/3-green.svg" width="16" height="16" alt="">4
                                        </span>
                                        <span class="d-atr" style="display:flex; align-items:center; gap:4px;">
                                            <img src="~/Rentaly/images/icons/4-green.svg" width="16" height="16" alt="">@item.FuelType
                                        </span>
                                    </div>
                                    <div class="d-price" style="display:flex; justify-content:space-between; align-items:center; margin-top:15px;">
                                        <div>
                                            Günlük fiyat<br>
                                            <span>@item.DailyPrice.ToString("F0") ₺</span>
                                        </div>
                                        <a class="btn-main" href="/Reservation/Create?carId=@item.CarId
&pickUpDateTime=@ViewBag.PickUpDateTime
&returnDateTime=@ViewBag.ReturnDateTime
&pickUpLocation=@ViewBag.PickUpLocation
&dropOffLocation=@ViewBag.DropOffLocation">Kirala</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
@model Faq

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2>Yeni Soru-Cevap Ekle</h2>
            <form method="post" action="/Faq/Create">
                <div class="mb-3">
                    <label>Soru</label>
                    <input type="text" class="form-control" asp-for="Question">
                </div>
                <div class="mb-3">
                    <label>Cevap</label>
                    <textarea class="form-control" asp-for="Answer" rows="4"></textarea>
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Kaydet
                </button>
                <a href="/Faq/Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Geri Dön
                </a>
            </form>
        </div>
    </div>
</div>


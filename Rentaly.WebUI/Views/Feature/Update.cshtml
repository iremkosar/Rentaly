@model Rentaly.EntityLayer.Entities.Feature
@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2>Feature Düzenle</h2>
            <form method="post" action="/Feature/Update">
                <input type="hidden" asp-for="FeatureId" />
                <div class="mb-3">
                    <label>İkon</label>
                    <input type="text" class="form-control" asp-for="Icon" placeholder="fa fa-trophy">
                </div>
                <div class="mb-3">
                    <label>Başlık</label>
                    <input type="text" class="form-control" asp-for="Title">
                </div>
                <div class="mb-3">
                    <label>Açıklama</label>
                    <textarea class="form-control" asp-for="Description" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label>Resim URL</label>
                    <input type="text" class="form-control" asp-for="ImageUrl">
                </div>
                <div class="mb-3">
                    <label>Bölüm Başlığı</label>
                    <input type="text" class="form-control" asp-for="SectionTitle">
                </div>
                <div class="mb-3">
                    <label>Bölüm Açıklaması</label>
                    <textarea class="form-control" asp-for="SectionDescription" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-success">Kaydet</button>
                <a href="/Feature/Index" class="btn btn-secondary">Geri Dön</a>
            </form>
        </div>
    </div>
</div>


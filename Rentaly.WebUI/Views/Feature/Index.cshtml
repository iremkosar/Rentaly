@model List<Rentaly.EntityLayer.Entities.Feature>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>Feature Listesi</h2>
            <a href="/Feature/Create" class="btn btn-success mb-3">Yeni Ekle</a>
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>İkon</th>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th>Resim</th>
                        <th>Bölüm Başlığı</th>
                        <th>Bölüm Açıklaması</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FeatureId</td>
                            <td><i class="fa @item.Icon"></i> @item.Icon</td>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            <td>@item.ImageUrl</td>
                            <td>@item.SectionTitle</td>
                            <td>@item.SectionDescription</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="/Feature/Update/@item.FeatureId" class="btn btn-warning btn-sm">
                                        <i class="fa fa-pencil"></i> Düzenle
                                    </a>
                                    <a href="/Feature/Delete/@item.FeatureId" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                        <i class="fa fa-trash"></i> Sil
                                    </a>
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


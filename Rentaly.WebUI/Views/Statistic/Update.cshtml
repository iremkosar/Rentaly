@model Statistic
@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2>İstatistik Düzenle</h2>           
            <form method="post" action="/Statistic/Update">
                <input type="hidden" asp-for="StatisticId" />
                <div class="mb-3">
                    <label>Başlık</label>
                    <input type="text" class="form-control" asp-for="Title" placeholder="Örn: Tamamlanan Siparişler">
                </div>
                <div class="mb-3">
                    <label>Değer</label>
                    <input type="number" class="form-control" asp-for="Count" placeholder="Örn: 15425">
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Güncelle
                </button>
                <a href="/Statistic/Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Geri Dön
                </a>
            </form>
        </div>
    </div>
</div>


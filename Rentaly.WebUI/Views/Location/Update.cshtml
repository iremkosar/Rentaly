@model Location

@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2>Lokasyon Güncelle</h2>
            <form method="post" action="/Location/Update">
                <input type="hidden" name="LocationId" value="@Model.LocationId">
                <div class="mb-3">
                    <label>Lokasyon Adı</label>
                    <input type="text" name="LocationName" value="@Model.LocationName" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-warning">Güncelle</button>
                <a href="/Location/Index" class="btn btn-secondary">Geri Dön</a>
            </form>
        </div>
    </div>
</div>


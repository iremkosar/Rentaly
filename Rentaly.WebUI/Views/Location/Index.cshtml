@model List<Location>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}



<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>Lokasyon Listesi</h2>
            <a href="/Location/CreateLocation" class="btn btn-success mb-3">Yeni Ekle</a>
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Lokasyon Adı</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.LocationId</td>
                            <td>@item.LocationName</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="/Location/Update/@item.LocationId" class="btn btn-warning btn-sm">
                                        <i class="fa fa-pencil"></i> Düzenle
                                    </a>
                                    <a href="/Location/Delete/@item.LocationId" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                        <i class="fa fa-trash"></i> Sil
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


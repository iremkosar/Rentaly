@model List<Testimonial>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Müşteri Yorumları</h1>
        <p class="page-subtitle">Müşteri geri bildirimlerini buradan yönetebilirsiniz.</p>
    </div>
    <a href="/Testimonial/Create" class="btn-primary-custom">
        <i class="fa-solid fa-plus"></i> Yeni Yorum Ekle
    </a>
</div>


<!-- ═══ Tablo ═══ -->
<div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden;">
    <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;" id="testimonialTable">
            <thead>
                <tr style="background:#f8fafc;border-bottom:2px solid var(--border);">
                    <th style="padding:13px 18px;text-align:left;font-size:11.5px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;width:220px;">Müşteri</th>
                    <th style="padding:13px 18px;text-align:left;font-size:11.5px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;width:160px;">Başlık</th>
                    <th style="padding:13px 18px;text-align:left;font-size:11.5px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;">Yorum</th>
                    <th style="padding:13px 18px;text-align:center;font-size:11.5px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.6px;width:160px;">İşlemler</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @foreach (var item in Model)
                {
                    <tr class="tbl-row"
                        data-author="@item.AuthorName?.ToLower()"
                        data-title="@item.Title?.ToLower()"
                        style="border-bottom:1px solid var(--border);transition:background .15s;"
                        onmouseover="this.style.background='#f8fafc'"
                        onmouseout="this.style.background=''">

                        <!-- Müşteri -->
                        <td style="padding:14px 18px;">
                            <div style="display:flex;align-items:center;gap:10px;">
                                <img src="@item.ImageUrl"
                                     alt="@item.AuthorName"
                                     style="width:42px;height:42px;border-radius:50%;object-fit:cover;border:2px solid var(--border);"
                                     onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(item.AuthorName ?? "U")&background=1a56db&color=fff&size=80'" />
                                <div>
                                    <div style="font-family:'Plus Jakarta Sans',sans-serif;font-size:13.5px;font-weight:700;color:var(--text-main);">@item.AuthorName</div>
                                    <div style="font-size:11.5px;color:var(--text-muted);">ID: #@item.TestimonialId</div>
                                </div>
                            </div>
                        </td>

                        <!-- Başlık -->
                        <td style="padding:14px 18px;">
                            <span style="display:inline-block;background:var(--primary-light);color:var(--primary);font-size:12px;font-weight:600;padding:4px 10px;border-radius:20px;white-space:nowrap;">
                                @item.Title
                            </span>
                        </td>

                        <!-- Yorum -->
                        <td style="padding:14px 18px;max-width:340px;">
                            <div style="font-size:13px;color:var(--text-muted);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                                @item.Comment
                            </div>
                        </td>

                        <!-- İşlemler -->
                        <!-- İşlemler -->
                        <td style="padding:14px 18px;">
                            <div style="display:flex;gap:6px;justify-content:center;">
                                <a href="/Testimonial/Update/@item.TestimonialId"
                                   style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:#fef3c7;color:#92400e;border-radius:8px;font-size:12.5px;font-weight:600;text-decoration:none;transition:all .2s;border:1px solid #fde68a;"
                                   onmouseover="this.style.background='#f59e0b';this.style.color='#fff';this.style.borderColor='#f59e0b';"
                                   onmouseout="this.style.background='#fef3c7';this.style.color='#92400e';this.style.borderColor='#fde68a';">
                                    <i class="fa-solid fa-pen-to-square"></i> Düzenle
                                </a>
                                <a href="/Testimonial/Delete/@item.TestimonialId"
                                   onclick="return confirm('Bu yorumu silmek istediğinize emin misiniz?')"
                                   style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:#fee2e2;color:#991b1b;border-radius:8px;font-size:12.5px;font-weight:600;text-decoration:none;transition:all .2s;border:1px solid #fecaca;"
                                   onmouseover="this.style.background='#ef4444';this.style.color='#fff';this.style.borderColor='#ef4444';"
                                   onmouseout="this.style.background='#fee2e2';this.style.color='#991b1b';this.style.borderColor='#fecaca';">
                                    <i class="fa-solid fa-trash-can"></i> Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fa-solid fa-comment-dots"></i></div>
            <h6 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;margin-bottom:6px;">Henüz Yorum Eklenmemiş</h6>
            <p style="font-size:13.5px;color:var(--text-muted);margin-bottom:14px;">İlk yorumu ekleyerek başlayın.</p>
            <a href="/Testimonial/Create" class="btn-primary-custom">
                <i class="fa-solid fa-plus"></i> Yeni Yorum Ekle
            </a>
        </div>
    }
</div>

<div id="emptySearch" style="display:none;" class="empty-state">
    <div class="empty-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
    <h6 style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;margin-bottom:6px;">Sonuç Bulunamadı</h6>
    <p style="font-size:13.5px;color:var(--text-muted);margin-bottom:14px;">Arama kriterinizle eşleşen yorum yok.</p>
    <button class="btn-primary-custom" onclick="resetFilter()">
        <i class="fa-solid fa-rotate-left"></i> Temizle
    </button>
</div>

<script>
    function filterTable() {
        const q = document.getElementById('searchInput').value.toLowerCase().trim();
        const rows = [...document.querySelectorAll('.tbl-row')];

        rows.forEach(r => {
            const author = r.dataset.author || '';
            const title  = r.dataset.title  || '';
            r.style.display = (!q || author.includes(q) || title.includes(q)) ? '' : 'none';
        });

        const visible = rows.filter(r => r.style.display !== 'none');
        const tableWrap = document.querySelector('[style*="overflow:hidden"]');
        document.getElementById('emptySearch').style.display  = visible.length === 0 ? 'block' : 'none';
        tableWrap.style.display = visible.length === 0 ? 'none' : 'block';
    }

    function resetFilter() {
        document.getElementById('searchInput').value = '';
        filterTable();
    }
</script>
@model List<Testimonial>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>Testimonial Listesi</h2>
            <a href="/Testimonial/Create" class="btn btn-success mb-3">
                <i class="fa fa-plus"></i> Yeni Ekle
            </a>
            <table class="table table-bordered table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Başlık</th>
                        <th>Yorum</th>
                        <th>Yazar</th>
                        <th>Resim</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TestimonialId</td>
                            <td>@item.Title</td>
                            <td>@item.Comment</td>
                            <td>@item.AuthorName</td>
                            <td>@item.ImageUrl</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="/Testimonial/Update/@item.TestimonialId" class="btn btn-warning btn-sm">
                                        <i class="fa fa-pencil"></i> Düzenle
                                    </a>
                                    <a href="/Testimonial/Delete/@item.TestimonialId" class="btn btn-danger btn-sm"
                                       onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                        <i class="fa fa-trash"></i> Sil
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


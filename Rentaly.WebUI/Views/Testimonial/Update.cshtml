@model Testimonial

@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2>Testimonial Düzenle</h2>
            <form method="post" action="/Testimonial/Update">
                <input type="hidden" asp-for="TestimonialId" />
                <div class="mb-3">
                    <label>Başlık</label>
                    <input type="text" class="form-control" asp-for="Title">
                </div>
                <div class="mb-3">
                    <label>Yorum</label>
                    <textarea class="form-control" asp-for="Comment" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label>Yazar Adı</label>
                    <input type="text" class="form-control" asp-for="AuthorName">
                </div>
                <div class="mb-3">
                    <label>Resim URL</label>
                    <input type="text" class="form-control" asp-for="ImageUrl">
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Güncelle
                </button>
                <a href="/Testimonial/Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Geri Dön
                </a>
            </form>
        </div>
    </div>
</div>


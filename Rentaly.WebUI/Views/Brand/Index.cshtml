@model List<Rentaly.EntityLayer.Entities.Brand>
@{
    ViewData["Title"] = "Marka Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-12 d-flex justify-content-between align-items-center">
            <h2>Marka Listesi</h2>
            <a href="/Brand/CreateBrand" class="btn btn-success">
                <i class="fa fa-plus"></i> Yeni Marka Ekle
            </a>
        </div>
    </div>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-xl-3 col-lg-4  col-md-4 col-sm-6 mb-4">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@Url.Content(item.ImageUrl)"
                                 style="width: 80px; height: 80px; object-fit: contain;"
                                 class="mb-3" alt="@item.BrandName">
                        }
                        else
                        {
                            <div style="width:80px; height:80px; background:#f0f0f0; border-radius:50%; display:flex; align-items:center; justify-content:center;" class="mb-3">
                                <i class="fa fa-car fa-2x text-muted"></i>
                            </div>
                        }
                        <h6 class="fw-bold mb-3">@item.BrandName</h6>
                        <div class="d-flex gap-2">
                            <a href="/Brand/Update/@item.BrandId" class="btn btn-warning btn-sm">
                                <i class="fa fa-pencil"></i>
                            </a>
                            <a href="/Brand/Delete/@item.BrandId" class="btn btn-danger btn-sm"
                               onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                <i class="fa fa-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
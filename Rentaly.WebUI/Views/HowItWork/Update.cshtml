@model HowItWork
@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2>Adım Düzenle</h2>
            <form method="post" action="/HowItWork/Update">
                <input type="hidden" asp-for="HowItWorkId" />
                <div class="mb-3">
                    <label>Adım Numarası</label>
                    <input type="number" class="form-control" asp-for="StepNumber" placeholder="1">
                </div>
                <div class="mb-3">
                    <label>Başlık</label>
                    <input type="text" class="form-control" asp-for="Title" placeholder="Araç Seçin">
                </div>
                <div class="mb-3">
                    <label>Açıklama</label>
                    <textarea class="form-control" asp-for="Description" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-save"></i> Güncelle
                </button>
                <a href="/HowItWork/Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Geri Dön
                </a>
            </form>
        </div>
    </div>
</div>



